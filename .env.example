# VITE_TMDB_API_KEY: Required for movie/TV metadata search (Phase 1+).
# Get a free key at https://www.themoviedb.org/settings/api
# Copy this file to .env.local and fill in the value. Never commit .env.local.
VITE_TMDB_API_KEY=

# VITE_ANILIST_CLIENT_ID: Required for "Push to AniList" sync.
# Create a free API client at https://anilist.co/settings/developer
# (redirect URL = the deployed app URL). The id is public-safe.
VITE_ANILIST_CLIENT_ID=

# MAL_CLIENT_ID (server-side only — set in Vercel env vars, NOT here):
# Required by api/mal-list.js for "Pull from MyAnimeList".
# Create a free client id at https://myanimelist.net/apiconfig
